# Upstart job for dbtail, the log tailer for ClickHouse by Altinity
# https://altinity.com/

description     "DBtail Daemon"
author          "Andrey Monakhov <andrey@altinity.com>"

start on runlevel [2345]
stop on runlevel [!2345]

respawn

exec su -s /bin/sh -c 'exec "$0" "$@"' root -- /usr/bin/dbtail -c /etc/dbtail/dbtail.conf
